# === Database ===
DATABASE_URL=postgresql://rmm_app:changeme@localhost:5432/rmmdb
# Only used by docker-compose.yml to set the Postgres container's password
# (must match the password portion of DATABASE_URL above when using Docker).
# docker-compose refuses to start if this is unset — no insecure default.
DB_PASSWORD=changeme

# === Flask ===
FLASK_ENV=development
# Set to 0 (or leave unset) in production/Docker — 1 enables the Werkzeug
# interactive debugger, which is a remote-code-execution risk if exposed.
# api/app.py defaults to 0 when unset; only set to 1 for local dev.
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-random-256-bit-secret
JWT_SECRET_KEY=change-this-to-another-random-secret
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# === Redis / Celery ===
# Use 127.0.0.1, NOT localhost — on Windows, localhost resolves IPv6 first (~2.5s penalty per cold connection)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Only used by docker-compose.yml, which runs Redis with --requirepass and
# builds authenticated redis:// URLs from this value. docker-compose refuses
# to start if unset — no insecure default. Not needed for local (non-Docker) dev.
REDIS_PASSWORD=change-this-to-a-random-secret

# === API ===
API_HOST=0.0.0.0
API_PORT=5000
DASHBOARD_URL=http://localhost:3000
# For mobile/LAN access set to your PC's LAN IP, e.g. http://192.168.1.x:8501

# === Agent ===
# One-time org registration token — rotate after all agents registered
ORG_REGISTRATION_TOKEN=change-this-to-a-secure-random-token

# === Superadmin ===
# REQUIRED — API refuses to start without this. Min 10 characters.
SUPERADMIN_EMAIL=superadmin@rmm.local
SUPERADMIN_PASSWORD=change-this-strong-password

# === CORS ===
# Comma-separated list of allowed frontend origins (no wildcards in production)
# Dev: React Vite dev server runs on port 3000
# Prod: set to your public domain only, e.g. https://rmm.yourcompany.com
CORS_ORIGINS=http://localhost:3000

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=RMM System <your@email.com>

# === Frontend ===
# React dev server port — used for CORS and Stripe redirect URLs in dev
DASHBOARD_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:5000

# === Stripe (Payment Processing) ===
# Get these from https://dashboard.stripe.com/apikeys (use test keys first)
STRIPE_SECRET_KEY=sk_live_...
# Get webhook secret from https://dashboard.stripe.com/webhooks after adding endpoint:
#   POST https://your-api-domain/api/billing/stripe/webhook
#   Events to listen: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe redirects after payment (set to your client-facing URL)
STRIPE_SUCCESS_URL=http://localhost:3000/billing?stripe=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?stripe=cancelled

# === Agent Auto-Update ===
# Bump LATEST_AGENT_VERSION when you deploy new agent code.
# Agents running older versions will auto-download and restart.
LATEST_AGENT_VERSION=1.0.0
# Absolute path to the agent zip file served to agents for download.
# Leave blank to disable auto-download (agents will still see update_available=true).
AGENT_UPDATE_PATH=
# Optional changelog shown in dashboard (one line).
AGENT_CHANGELOG=

# === AI Assistant ===
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
AI_ASSISTANT_MODEL=claude-haiku-4-5-20251001
AI_ASSISTANT_ENABLED=true
# Master switch above disables the whole feature (incl. plain Q&A). The switch below
# gates only the agentic tool-use/actions layer — if it misbehaves, set to false and
# the assistant falls back to today's read-only Q&A behavior (no tools=, no confirm/deny).
AI_ASSISTANT_AGENTIC_ENABLED=true
AI_ASSISTANT_MAX_TOOL_ITERATIONS=4
AI_ASSISTANT_ACTION_TTL_SECONDS=300
AI_ASSISTANT_MAX_TOKENS=900
AI_ASSISTANT_HISTORY_TURNS=10
# Estimated $ cost per 1M tokens for the configured model — used only to display an
# "Estimated cost" figure on the superadmin-only Usage Monitoring page/report. Not
# authoritative billing data. Defaults are Claude Haiku 4.5 list pricing.
AI_ASSISTANT_COST_PER_1M_INPUT=1.00
AI_ASSISTANT_COST_PER_1M_OUTPUT=5.00

# === AI Ticket Triage ===
# Categorizes every new ticket and, for a curated whitelist of categories (see
# Admin -> AI Triage, or PUT /api/triage/categories/<id>), lets the AI draft a
# customer reply and resolve the ticket — gated per-category by auto_resolve_enabled
# + shadow_mode in the triage_categories table (DB-configurable, not env-only).
AI_TRIAGE_ENABLED=true
# Defaults to AI_ASSISTANT_MODEL's value if unset.
AI_TRIAGE_MODEL=
AI_TRIAGE_MAX_TOKENS=500
# Global cap on triage Anthropic calls per hour — protects cost/blast-radius on
# this unattended pipeline. Exceeding it escalates the ticket rather than skipping it.
AI_TRIAGE_RATE_LIMIT_PER_HOUR=300
# Days of no customer reply before an AI auto-resolved ticket is closed automatically.
# Per-category override available via TriageCategory.auto_close_days.
AI_TRIAGE_AUTO_CLOSE_DAYS=7
# Internal-facing recipients for "a ticket needs human review" notifications when
# the ticket has no assignee yet. Comma-separated.
TRIAGE_ESCALATION_FALLBACK_EMAILS=

# === Database Backup ===
# Directory where nightly pg_dump backups are saved.
# Use a network drive or cloud-synced path for off-site protection.
BACKUP_DIR=../backups
# Number of days to retain backup files before auto-deletion.
BACKUP_RETAIN_DAYS=7

# === IoT / MQTT ===
# Connect to an external MQTT broker (Mosquitto, HiveMQ, etc.) for sensor ingestion.
# Leave MQTT_HOST blank to disable MQTT polling (no-op, no error).
# Topic convention: {MQTT_TOPIC_PREFIX}/{device_id}/sensors/{sensor_type}
# Payload: JSON {"value": <float>, "unit": "<str>", "channel": "<str|null>"}
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=rmm

# === PSA Integrations ===
# ConnectWise Manage and Autotask credentials are stored encrypted in the DB.
# Configure integrations at Admin → PSA Integrations in the dashboard,
# or via POST /api/psa/integrations.
# Sync runs automatically every 15 minutes via Celery beat.
# ConnectWise: api_url = https://yourserver/v4_6_release/apis/3.0
# Autotask:    api_url = https://webservices1.autotask.net/ATServicesRest/V1.0

# === Mobile Device Management (Android) ===
# Real phone management (lock/wipe/lost-mode/compliance) via Google's Android
# Management API — no custom agent runs on the phone; Google's own signed
# "Android Device Policy" app is provisioned during enrollment.
# Setup: create a GCP project + service account, enable the Android Management
# API, then create an integration + upload the service-account JSON key via
# Admin -> Mobile Enrollment in the dashboard (or POST /api/mdm/integrations).
# The service-account JSON and enrollment tokens are stored encrypted in the
# DB, never in this file or on disk. iOS is not implemented (requires an
# Apple Business Manager / vendor-signed MDM decision made outside this repo).
# Sync runs automatically every 5 minutes via Celery beat.

# === SNMP ===
# SNMP community string is stored per-device in Device.metadata_.snmp_community
# via the device Edit form. No global config needed here.
# Timeout for each SNMP GET request (seconds).
SNMP_TIMEOUT=3

# === Error Tracking (Sentry) ===
# Get DSN at https://sentry.io — free tier covers 10K errors/month.
# Leave blank to disable (no-op — no errors raised if unset).
SENTRY_DSN=

# === Support Inbox (Email-to-Ticket) ===
# Set these to enable inbound email → auto ticket creation.
# Use an app password (not your main password) for Gmail/Outlook.
SUPPORT_IMAP_HOST=imap.gmail.com
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_USER=support@yourcompany.com
SUPPORT_IMAP_PASSWORD=your-app-password
# Fallback customer ID for emails from unregistered senders.
# Find the UUID in Admin → Customers.
DEFAULT_INBOUND_CUSTOMER_ID=
# Catch-all customer ID used when DEFAULT_INBOUND_CUSTOMER_ID is also unset, so
# an inbound support email always becomes a ticket instead of being silently
# dropped. A human can reassign the ticket to the right customer afterward.
# Leave both blank to skip unknown senders entirely (old behavior).
UNASSIGNED_INBOUND_CUSTOMER_ID=
